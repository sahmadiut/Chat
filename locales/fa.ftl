# ─── User Menu (Reply Keyboard) ──────────────────────
menu-user-help = 📋 راهنما
menu-user-profile = 👤 پروفایل من
menu-user-support = 📞 پشتیبانی
menu-user-about = ℹ️ درباره ربات

# ─── Welcome / Start ─────────────────────────────────
welcome = 👋 <b>سلام { $name }، خوش آمدید</b>

    بخش موردنظر را از منوی زیر انتخاب کنید.

help = 📋 <b>راهنما و امکانات</b>

    دستورات و بخش‌های موجود:
    • <b>/start</b> - باز کردن منوی اصلی
    • <b>/help</b> - نمایش همین متن راهنما
    • <b>/profile</b> - مشاهده و ویرایش اطلاعات پروفایل
    • <b>/notifications</b> - تنظیم و مدیریت اعلان‌ها
    • <b>/support</b> - ارتباط با پشتیبانی
    • <b>/about</b> - اطلاعات درباره این ربات

help-admin = 📋 <b>راهنما و امکانات</b>

    دستورات و بخش‌های موجود:
    • <b>/start</b> - باز کردن منوی اصلی
    • <b>/help</b> - نمایش همین متن راهنما
    • <b>/profile</b> - مشاهده و ویرایش اطلاعات پروفایل
    • <b>/notifications</b> - تنظیم و مدیریت اعلان‌ها
    • <b>/support</b> - ارتباط با پشتیبانی
    • <b>/about</b> - اطلاعات درباره این ربات
    • <b>/admin</b> - باز کردن پنل مدیریت

about = ℹ️ <b>درباره ربات</b>

    یک سرویس تلگرامی سریع و پایدار با رابط ساده و دوزبانه.

# ─── User Profile ─────────────────────────────────────
user-profile-title = 👤 <b>پروفایل من</b>
user-profile-id = 🆔 <b>شناسه:</b> <code>{ $id }</code>
user-profile-name = 👤 <b>نام:</b> { $name }
user-profile-username = 🔗 <b>نام کاربری:</b> { $username }
user-profile-joined = 📅 <b>عضویت:</b> <code>{ $joined }</code>
user-profile-status = 📌 <b>وضعیت:</b> { $status }
user-profile-status-active = 🟢 فعال
user-profile-status-banned = 🚫 مسدود
user-profile-btn-notifications = 🔔 اعلان‌ها
user-profile-btn-lang = 🌐 زبان
user-profile-edit-name-prompt = ✏️ لطفاً نام جدید خود را ارسال کنید (یا برای انصراف /cancel را بفرستید):
user-profile-edit-name-success = ✅ نام شما به <b>{ $name }</b> به‌روزرسانی شد!
user-profile-premium = ⭐ پریمیوم: { $isPremium }
user-profile-language = 🌐 زبان: { $lang }
user-profile-ban-reason = 📝 دلیل مسدودی: { $reason }
user-profile-yes = بله
user-profile-no = خیر
user-profile-none = بدون نام کاربری

# ─── Support Flow ─────────────────────────────────────
support-intro = 📞 <b>ارتباط با پشتیبانی</b>

    لطفاً پیام یا پرسش خود را تایپ و ارسال کنید. پیام شما مستقیماً برای تیم پشتیبانی ارسال خواهد شد.
support-sent-success = ✅ پیام شما برای پشتیبانی ارسال شد. به زودی پاسخگوی شما خواهیم بود!
support-admin-forward = 📬 <b>پیام جدید پشتیبانی</b>

    👤 <b>کاربر:</b> { $name }
    🆔 <b>شناسه عددی:</b> <code>{ $id }</code>
    🔗 <b>نام کاربری:</b> { $username }
support-admin-btn-view-user = 👤 مشاهده کاربر
support-admin-btn-reply = ✉️ پاسخ
support-admin-btn-ban = 🚫 مسدود کردن
support-admin-msg-failed = ⚠️ <b>خطا در ارسال پیام کاربر</b>

    متأسفانه فوروارد و کپی پیام کاربر به دلیل خطای زیر با شکست مواجه شد:
    <code>{ $error }</code>

# ─── Settings Feature ─────────────────────────────────
settings-title = ⚙️ <b>تنظیمات</b>

    تنظیمات رابط کاربری خود را مدیریت کنید:
settings-language = 🌐 <b>انتخاب زبان</b>

    زبان مورد استفاده در همه بخش‌های ربات را انتخاب کنید:
settings-language-changed = ✅ زبان با موفقیت تغییر کرد!
settings-language-button = 🌐 زبان رابط
settings-home-button = 🏠 منوی اصلی
settings-back-button = ↩️ بازگشت
settings-notifications-button = 🔔 تنظیمات اعلان‌ها

# ─── Admin Menu (Root) ────────────────────────────────
admin-menu-title = 🛡 <b>پنل مدیریت</b>

    به مرکز کنترل و مدیریت ربات خوش آمدید.
admin-btn-stats = 📊 آمار
admin-btn-users = 👥 کاربران
admin-btn-broadcast = 📢 ارسال همگانی
admin-btn-settings = ⚙️ تنظیمات
admin-btn-close = ❌ بستن
admin-closed-alert = پنل مدیریت بسته شد

# ─── Admin: Stats ─────────────────────────────────────
admin-stats-title = 📊 <b>آمار ربات</b>
admin-stats-total = 👥 <b>کل کاربران:</b> <code>{ $total }</code>
admin-stats-active-today = 🟢 <b>فعال امروز:</b> <code>{ $active }</code>
admin-stats-new-7days = 🆕 <b>جدید (۷ روز گذشته):</b> <code>{ $newUsers }</code>
admin-stats-banned = 🚫 <b>مسدودشده:</b> <code>{ $banned }</code>

# ─── Admin: Users ─────────────────────────────────────
admin-users-title = 👥 <b>مدیریت کاربران</b>

    کاربر را جست‌وجو کنید یا فهرست کاربران ثبت‌شده را مرور نمایید:
admin-users-btn-search = 🔍 جست‌وجو
admin-users-btn-list = 📋 فهرست کاربران
admin-users-card-title = 👤 <b>مشخصات کاربر</b>
admin-users-btn-message = ✉️ ارسال پیام
admin-users-btn-ban = 🚫 مسدود کردن
admin-users-btn-unban = ✅ رفع مسدودیت
admin-users-btn-back-list = 🔙 بازگشت به فهرست
admin-users-search-prompt = 🔍 <b>جست‌وجوی کاربران</b>

    شناسه عددی یا @نام‌کاربری را بفرستید، پیامی را فوروارد کنید یا از دکمه زیر برای انتخاب از مخاطبان استفاده نمایید:
admin-users-search-btn-contacts = 👤 انتخاب از مخاطبان
admin-users-search-no-results = ❌ کاربری با مشخصات «{ $query }» پیدا نشد.
admin-users-search-results = 🔍 تعداد <b>{ $count }</b> کاربر برای «{ $query }» یافت شد:

# ─── Admin: Confirmations ─────────────────────────────
admin-confirm-ban-title = ⚠️ <b>تأیید مسدودسازی</b>

    آیا از مسدود کردن کاربر <b>{ $name }</b> (<code>{ $id }</code>) مطمئن هستید؟
admin-confirm-unban-title = ⚠️ <b>تأیید رفع مسدودیت</b>

    آیا از رفع مسدودیت کاربر <b>{ $name }</b> (<code>{ $id }</code>) مطمئن هستید؟
admin-action-ban-success = کاربر { $id } مسدود شد.
admin-action-unban-success = مسدودیت کاربر { $id } برطرف شد.

# ─── Admin: Direct Message ────────────────────────────
admin-dm-prompt = ✉️ <b>ارسال پاسخ / پیام مستقیم</b>

    گیرنده: <b>{ $name }</b> (<code>{ $id }</code>)

    لطفاً پیام پاسخ خود را ارسال کنید (متن، عکس، ویدیو، صدا یا سند):
admin-dm-success = ✅ پیام برای <b>{ $name }</b> ارسال شد.
admin-dm-failed = ❌ ارسال پیام ناموفق بود: { $error }
admin-dm-incoming-header = 📬 <b>پاسخ پشتیبانی به پیام شما:</b>

# ─── Admin: Broadcast ─────────────────────────────────
admin-broadcast-step1-title = 📢 <b>ارسال همگانی — مرحله ۱/۴: انتخاب مخاطبان</b>

    مشخص کنید پیام برای چه کسانی ارسال شود:
admin-broadcast-aud-all = 👥 همه کاربران ({ $count })
admin-broadcast-aud-active = 🟢 فقط کاربران فعال ({ $count })
admin-broadcast-step2-prompt = 📢 <b>ارسال همگانی — مرحله ۲/۴: متن یا محتوای پیام</b>

    محتوای پیام موردنظر را برای ارسال بفرستید (متن، عکس و ...).
admin-broadcast-step3-title = 📢 <b>ارسال همگانی — مرحله ۳/۴: پیش‌نمایش پیام</b>

    پیام شما به این صورت ارسال خواهد شد:
admin-broadcast-btn-send = ✅ ارسال
admin-broadcast-btn-edit = ✏️ ویرایش
admin-broadcast-step4-report = 📢 <b>نتیجه ارسال همگانی</b>

    ✅ <b>موفق:</b> { $sent }
    ❌ <b>ناموفق:</b> { $failed }

# ─── Admin: Settings ──────────────────────────────────
admin-settings-title = ⚙️ <b>تنظیمات ربات</b>
admin-settings-maint-on = 🔧 حالت تعمیر: ✅
admin-settings-maint-off = 🔧 حالت تعمیر: ❌
admin-settings-force-join-on = 📢 عضویت اجباری کانال: ✅
admin-settings-force-join-off = 📢 عضویت اجباری کانال: ❌
admin-settings-edit-welcome = ✉️ ویرایش پیام خوش‌آمدگویی
admin-settings-welcome-prompt = ✉️ <b>ویرایش پیام خوش‌آمدگویی</b>

    پیام فعلی:
    { $current }

    متن جدید را ارسال کنید یا برای بازنشانی به حالت پیش‌فرض، عبارت <code>/reset</code> را بفرستید:
admin-settings-welcome-updated = ✅ پیام خوش‌آمدگویی با موفقیت به‌روزرسانی شد!
admin-settings-welcome-reset = ✅ پیام خوش‌آمدگویی به حالت پیش‌فرض بازنشانی شد!
admin-settings-language = 🌐 زبان پیش‌فرض
admin-settings-language-prompt = 🌐 <b>انتخاب زبان پیش‌فرض ربات</b>

    زبان پیش‌فرض ربات را برای کاربرانی که زبانی تعیین نکرده‌اند انتخاب کنید:
admin-ban-reason-prefix = 📝 <b>دلیل مسدودی:</b> { $reason }

# ─── Notifications Feature ────────────────────────────
notifications-title = 🔔 <b>تنظیمات اعلان‌ها</b>

    اعلان‌هایی را که می‌خواهید دریافت کنید انتخاب کنید. تغییرات روی اعلان‌های صف‌بندی‌شده و زمان‌بندی‌شده نیز اعمال می‌شود.
notifications-type-announcements = اطلاعیه‌ها
notifications-type-reminders = یادآوری‌ها
notifications-type-product-updates = به‌روزرسانی‌های محصول
notifications-enabled = اعلان‌ها فعال شدند
notifications-disabled = اعلان‌ها بی‌صدا شدند
pagination-previous = ‹ قبلی
pagination-next = بعدی ›

