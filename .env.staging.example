# Use a dedicated staging bot, PostgreSQL database, Redis instance, and webhook host.
APP_ENV=staging
NODE_ENV=production
BOT_MODE=webhook
BOT_TOKEN=replace-with-staging-bot-token
BOT_USERNAME=replace_with_staging_bot_username
ADMIN_CHAT_ID=123456789
ADMIN_IDS=
WEBHOOK_URL=https://staging-bot.example.com
WEB_APP_URL=https://staging-bot.example.com/webapp
WEBHOOK_SECRET=replace-with-staging-webhook-secret
PORT=3000
DATABASE_URL=postgresql://staging_user:replace-password@staging-db.example.com:5432/staging_bot
REDIS_URL=redis://staging-redis.example.com:6379
DEFAULT_LANGUAGE=fa
LOG_LEVEL=info
LOG_DIR=logs
UPLOAD_DIR=uploads
DOWNLOAD_DIR=downloads
