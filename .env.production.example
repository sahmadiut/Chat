# Use production-only credentials, PostgreSQL database, Redis instance, and webhook host.
APP_ENV=production
NODE_ENV=production
BOT_MODE=webhook
BOT_TOKEN=replace-with-production-bot-token
BOT_USERNAME=replace_with_production_bot_username
ADMIN_CHAT_ID=123456789
ADMIN_IDS=
WEBHOOK_URL=https://bot.example.com
WEB_APP_URL=https://bot.example.com/webapp
WEBHOOK_SECRET=replace-with-production-webhook-secret
PORT=3000
DATABASE_URL=postgresql://production_user:replace-password@production-db.example.com:5432/production_bot
REDIS_URL=redis://production-redis.example.com:6379
DEFAULT_LANGUAGE=fa
LOG_LEVEL=info
LOG_DIR=logs
UPLOAD_DIR=uploads
DOWNLOAD_DIR=downloads
