# ──────────────────────────────────────────────
# Bot Configuration
# ──────────────────────────────────────────────

# Telegram Bot API token (obtained from @BotFather)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Bot username without the @ sign (used for deep linking and references)
BOT_USERNAME=my_awesome_bot

# Chat ID for admin alerts (your personal Telegram user ID)
ADMIN_CHAT_ID=123456789

# ──────────────────────────────────────────────
# Bot Mode & Webhook
# ──────────────────────────────────────────────

# How to receive updates: "polling" (dev) or "webhook" (prod)
BOT_MODE=polling

# Public URL for webhook (REQUIRED when BOT_MODE=webhook)
WEBHOOK_URL=https://bot.example.com

# Optional Telegram Mini App URL (defaults to WEBHOOK_URL/webapp)
WEB_APP_URL=https://bot.example.com/webapp

# Port for the Fastify webhook server
PORT=3000

# Secret token to validate incoming webhook requests from Telegram
WEBHOOK_SECRET=my-super-secret-token-change-me

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────

# PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_bot

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────

# Redis connection URL (used for sessions, caching, and BullMQ)
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────

# Default interface language: "fa" | "en"
DEFAULT_LANGUAGE=fa

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# Pino log level: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
LOG_LEVEL=info

# ──────────────────────────────────────────────
# Paths
# ──────────────────────────────────────────────

# Directory for storing log files
LOG_DIR=logs

# Directory for uploaded files
UPLOAD_DIR=uploads

# Directory for downloaded files
DOWNLOAD_DIR=downloads
